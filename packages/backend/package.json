{
  "name": "@can-i-deploy/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/db/seed.ts",
    "sync:run": "tsx src/sync/run.ts"
  },
  "dependencies": {
    "@can-i-deploy/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
